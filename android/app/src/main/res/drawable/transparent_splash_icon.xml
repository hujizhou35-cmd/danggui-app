<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ always owns a short system splash stage. Supplying an explicit
  transparent drawable prevents the platform from falling back to the launcher
  icon while StartupPage prepares the complete branded composition.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <size android:width="1dp" android:height="1dp"/>
</shape>
